{
  "name": "nestchat",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant SaaS chatbot platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "cd packages/server && node dist/index.js",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "seed": "pnpm --filter @nestchat/server run seed",
    "postinstall": "pnpm --filter @nestchat/shared build"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "turbo": "^2.10.6",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.10.0"
}
